<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Account Move Inherited View   -->
    <record id="unicommerce_account_move_form" model="ir.ui.view">
        <field name="name">unicommerce.account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_left_group']/div[hasclass('o_col')]" position="after">
                <field name="unicommerce_order_id" readonly="1"/>
            </xpath>
            <xpath expr="//page[@id='other_tab']//group[@id='other_tab_group']" position="after">
                <group string="Unicommerce Details" name="unicommerce_details_group">
                    <group>
                        <field name="shop_instance_id" readonly="1"/>
                        <field name="sales_channel_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="dump_sequence" string="Code" readonly="1"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>