<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Log Tree View -->
    <record id="view_sale_company_reassignment_log_tree" model="ir.ui.view">
        <field name="name">sale.company.reassignment.log.list</field>
        <field name="model">sale.company.reassignment.log</field>
        <field name="arch" type="xml">
            <list string="SO Company Reassignment Logs"
                  decoration-success="status == 'success'"
                  decoration-muted="status == 'nothing_to_update'"
                  decoration-danger="status == 'failed'"
                  create="false"
                  edit="false">
                <field name="name"/>
                <field name="execution_date"/>
                <field name="user_id"/>
                <field name="source_company_id"/>
                <field name="target_company_id"/>
                <field name="gstin_id"/>
                <field name="gst_code"/>
                <field name="action_type"/>
                <field name="records_updated"/>
                <field name="status" widget="badge"/>
                <field name="summary"/>
            </list>
        </field>
    </record>

    <!-- Log Form View -->
    <record id="view_sale_company_reassignment_log_form" model="ir.ui.view">
        <field name="name">sale.company.reassignment.log.form</field>
        <field name="model">sale.company.reassignment.log</field>
        <field name="arch" type="xml">
            <form string="SO Company Reassignment Log" create="false" edit="false">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Execution Metadata">
                            <field name="execution_date"/>
                            <field name="user_id"/>
                            <field name="action_type"/>
                            <field name="records_updated"/>
                            <field name="status" widget="badge"/>
                        </group>
                        <group string="Companies &amp; GST Details">
                            <field name="source_company_id"/>
                            <field name="target_company_id"/>
                            <field name="gstin_id"/>
                            <field name="gst_code"/>
                        </group>
                    </group>
                    <group string="Summary Details">
                        <field name="summary" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Log Search View -->
    <record id="view_sale_company_reassignment_log_search" model="ir.ui.view">
        <field name="name">sale.company.reassignment.log.search</field>
        <field name="model">sale.company.reassignment.log</field>
        <field name="arch" type="xml">
            <search string="Search Reassignment Logs">
                <field name="name"/>
                <field name="source_company_id"/>
                <field name="target_company_id"/>
                <field name="gstin_id"/>
                <field name="gst_code"/>
                <field name="user_id"/>
                <separator/>
                <filter string="Successful" name="filter_success" domain="[('status', '=', 'success')]"/>
                <filter string="Failed" name="filter_failed" domain="[('status', '=', 'failed')]"/>
                <group>
                    <filter string="Target Company" name="group_by_target" context="{'group_by': 'target_company_id'}"/>
                    <filter string="Action Type" name="group_by_action" context="{'group_by': 'action_type'}"/>
                    <filter string="Execution Date" name="group_by_date" context="{'group_by': 'execution_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_sale_company_reassignment_log" model="ir.actions.act_window">
        <field name="name">SO Company Reassignment Logs</field>
        <field name="res_model">sale.company.reassignment.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sale_company_reassignment_log_search"/>
    </record>

    <!-- Menuitem -->
    <menuitem id="menu_sale_company_reassignment_log"
              name="SO Company Reassignment Logs"
              parent="sale.menu_sale_config"
              action="action_sale_company_reassignment_log"
              sequence="95"/>
</odoo>
