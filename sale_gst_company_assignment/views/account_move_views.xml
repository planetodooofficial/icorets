<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Account Move Form: Add is_company_transferred -->
    <record id="view_move_form_company_transferred" model="ir.ui.view">
        <field name="name">account.move.form.company.transferred</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="is_company_transferred" invisible="1"/>
            </xpath>
        </field>
    </record>

    <!-- Account Move List: Add is_company_transferred -->
    <record id="view_move_tree_company_transferred" model="ir.ui.view">
        <field name="name">account.move.list.company.transferred</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="is_company_transferred" column_invisible="True"/>
            </xpath>
        </field>
    </record>

    <!-- Account Move Search: Add Filter for is_company_transferred -->
    <record id="view_account_move_filter_company_transferred" model="ir.ui.view">
        <field name="name">account.move.search.company.transferred</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_move_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='posted']" position="before">
            </xpath>
        </field>
    </record>
</odoo>
