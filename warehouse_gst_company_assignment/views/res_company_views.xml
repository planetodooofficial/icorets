<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_gst_code" model="ir.ui.view">
        <field name="name">res.company.form.gst.code</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <field name="gst_code_matching_com" placeholder="e.g. DL, CH, HR, MH"/>
            </xpath>
        </field>
    </record>
</odoo>
