<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_journal_form_inherit_company_reassign" model="ir.ui.view">
        <field name="name">account.journal.form.inherit.company.reassign</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <!-- Add Header with Button 1 and Button 2 right above sheet -->
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_open_company_reassign_wizard"
                            string="🔄 Reassign Company (Manual / Batch)"
                            type="object"
                            class="btn-primary"
                            help="Open wizard to manually select target branch company, fetch records, and reassign journal entries."/>
                    <button name="action_open_picking_match_wizard"
                            string="📦 Reassign by Stock Picking Match"
                            type="object"
                            class="btn-secondary"
                            help="Match journal entries against stock picking numbers and reassign them to the picking's branch company."/>
                </header>
            </xpath>

            <!-- Smart button in button box to view reassignment logs for this journal -->
            <!--xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_reassignment_logs"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-history">
                    <field name="reassignment_log_count" widget="statinfo" string="Transfer Logs"/>
                </button>
            </xpath-->

            <!-- Tab in notebook to view audit logs directly on the Journal form -->
            <xpath expr="//notebook" position="inside">
                <page string="Company Reassignment Logs" name="reassignment_logs_page">
                    <field name="reassignment_log_ids" readonly="1">
                        <list decoration-success="status == 'success'"
                              decoration-muted="status == 'nothing_to_update'"
                              decoration-danger="status == 'failed'">
                            <field name="name"/>
                            <field name="execution_date"/>
                            <field name="user_id"/>
                            <field name="source_company_id"/>
                            <field name="target_company_id"/>
                            <field name="action_type" widget="badge"/>
                            <field name="records_updated"/>
                            <field name="status" widget="badge"/>
                            <field name="summary"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
