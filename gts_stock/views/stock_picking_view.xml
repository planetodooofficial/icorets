<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="stock_view_picking_form_change_warehouse" model="ir.ui.view">
        <field name="name">picking.warehouse</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_cancel']" position="after">
                <button name="change_warehouse"
                        invisible="state not in ('assigned', 'confirmed', 'draft', 'waiting')"
                        string="Change Warehouse" type="object" data-hotkey="z"/>
            </xpath>
            <xpath expr="//field[@name='picking_type_id']" position="after">
                <field name="warehouse_id" invisible="1"/>
                <field name="bulk_return_id" invisible="1"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="view_bulk_return_picking"
                        string="Return"
                        type="object"
                        invisible="not bulk_return_id"
                        class="oe_stat_button">
                </button>
            </xpath>
        </field>
    </record>

    <record id="action_bulk_grn_return" model="ir.actions.server">
        <field name="name">Bulk GRN Return</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
if records:
    action = records.bulk_grn_return()
        </field>
    </record>

</odoo>