<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_template_form_view_inherit_hsn" model="ir.ui.view">
        <field name="name">product.template.form.inherit.hsn</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='accounting']" position="inside">
                <group string="HSN Details">
                    <field name="sale_hsn" options="{'no_create': True, 'no_open': True}"/>
                    <field name="sales_hsn_description"/>
                    <field name="purchase_hsn" options="{'no_create': True, 'no_open': True}"/>
                    <field name="purchase_hsn_description"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
