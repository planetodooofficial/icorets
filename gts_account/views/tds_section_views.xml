<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="section_tds_tree_view" model="ir.ui.view">
        <field name="name">section.tds.list.view</field>
        <field name="model">section.tds</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name" required="1"/>
            </list>
        </field>
    </record>

    <record id="section_tds_action" model="ir.actions.act_window">
        <field name="name">TDS Sections</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">section.tds</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
