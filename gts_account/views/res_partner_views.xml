<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="partner_form_inherited" model="ir.ui.view">
        <field name="name">res.partner.form.inherited.gts</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="supplier_rank" invisible="1"/>
                <field name="customer_rank" invisible="1"/>
                <field name="deductee_type_id" options="{'no_create': True, 'no_edit': True}"/>
                <field name="tds_tax_id" string="TDS Tax" domain="[('is_tds', '=', True), ('deductee_type_id', '=', deductee_type_id)]"/>
            </xpath>
            <xpath expr="//field[@name='vat']" position="attributes">
                <attribute name="string">GST No.</attribute>
            </xpath>
            <xpath expr="//div[hasclass('o_address_format')]" position="after">
                <field name="is_gstin"/>
            </xpath>
            <xpath expr="//group[@name='sale']" position="attributes">
                <attribute name="invisible">customer_rank == 0</attribute>
            </xpath>
            <xpath expr="//group[@name='purchase']" position="attributes">
                <attribute name="invisible">supplier_rank == 0</attribute>
            </xpath>
        </field>
    </record>

    <record id="base.action_partner_customer_form" model="ir.actions.act_window">
        <field name="name">Customers</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('parent_id', '=', False)]</field>
        <field name="context">{'res_partner_search_mode': 'customer', 'default_is_company': True}</field>
    </record>

    <record id="base.action_partner_supplier_form" model="ir.actions.act_window">
        <field name="name">Vendors</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.partner</field>
        <field name="domain">[('parent_id', '=', False)]</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'res_partner_search_mode': 'supplier', 'default_is_company': True}</field>
    </record>
</odoo>
