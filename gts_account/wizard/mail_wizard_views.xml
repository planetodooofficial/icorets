<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_mail_wizard_form" model="ir.ui.view">
        <field name="name">mail.wizard.form</field>
        <field name="model">mail.wizard</field>
        <field name="arch" type="xml">
            <form string="Send Email">
                <group>
                    <field name="to_partner_id"/>
                    <field name="cc_partner_ids" widget="many2many_tags"/>
                    <field name="subject"/>
                    <field name="body" widget="html"/>
                    <field name="attachment_ids" widget="many2many_binary" string="Attach a file" nolabel="1" colspan="2"/>
                </group>
                <footer>
                    <button string="Send" type="object" name="action_send_mail" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_mail_wizard" model="ir.actions.act_window">
        <field name="name">Mail Wizard</field>
        <field name="res_model">mail.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_mail_wizard_form"/>
    </record>
</odoo>
