<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wizard_form" model="ir.ui.view">
        <field name="name">wizard.action.button.form</field>
        <field name="model">wizard.action.button</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="from_date"/>
                    <field name="end_date"/>
                </group>
                <footer>
                    <button name="download_report" string="Download Report" type="object" data-hotkey="q" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="test_wizard_button" model="ir.actions.act_window">
        <field name="name">TDS Report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">wizard.action.button</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="account.model_account_move_line"/>
    </record>
</odoo>
