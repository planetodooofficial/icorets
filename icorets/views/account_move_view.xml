<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- Account Move Line Inherit -->
    <record id="inherit_account_move_line" model="ir.ui.view">
        <field name="name">inherit.account.move.line.tree</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="tax_amount_line" column_invisible="True"/>
            </xpath>
        </field>
    </record>

    <!-- Account Move Tree Inherit -->
    <record id="inherit_account_move_tree" model="ir.ui.view">
        <field name="name">inherit.account.move.tree</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_partner_display_name']" position="after">
                <field name="tot_line_qty" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Account Move Form Inherit -->
    <record id="inherit_account_move" model="ir.ui.view">
        <field name="name">inherit.account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">


            <xpath expr="//group[@id='header_left_group']/div[hasclass('o_col')]" position="after">
                <field name="cust_code"
                       invisible="move_type not in ('out_invoice', 'in_invoice')"/>
                <field name="ref" string="PO No" invisible="move_type != 'out_invoice'"/>
                <field name="event"
                       invisible="move_type not in ('out_invoice', 'in_invoice')"/>
                <field name="type_s" string='Type'
                       invisible="move_type not in ('out_invoice', 'in_invoice')"/>
                <field name="no_of_cartons"
                       invisible="move_type not in ('out_invoice', 'in_invoice')"/>
                <field name="shipping_id_credit" invisible="move_type != 'out_refund'"
                       options="{'no_create': True, 'no_open': True}"/>
            </xpath>

            <xpath expr="//field[@name='invoice_line_ids']//field[@name='account_id']"
                   position="after">
                <field name="myntra_sku_code" optional="hide"/>
                <field name="remarks" optional="hide"/>
            </xpath>

            <xpath expr="//field[@name='invoice_line_ids']//field[@name='product_id']"
                   position="after">
                <field name="article_code" optional="hide"/>
                <field name="ean_code" optional="hide"/>
                <field name="size" optional="hide"/>
                <field name="color" optional="hide"/>
            </xpath>

            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="options">{"no_create":true}</attribute>
            </xpath>

            <xpath expr="//field[@name='invoice_line_ids']//field[@name='product_id']"
                   position="attributes">
                <attribute name="options">{"no_create":true}</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='product_uom_id']"
                   position="attributes">
                <attribute name="options">{"no_create":true}</attribute>
            </xpath>

        </field>
    </record>

</odoo>
