<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- Inheriting purchase Order -->
    <record id="inherit_purchase_order" model="ir.ui.view">
        <field name="name">inherit.purchase.order.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">
                <button name="short_close" type="object" string="Short Close" class="oe_highlight"
                        invisible="is_short_close"/>
            </xpath>

            <xpath expr="//page[@name='purchase_delivery_invoice']/group/group[@name='other_info']/field[@name='user_id']" position="after">
                <field name="reason_id"/>
                <field name="desc"/>
                <field name="is_short_close" invisible="1"/>
                <field name="closer_date"/>
            </xpath>


            <xpath expr="//field[@name='currency_id']" position="after">
                <field name="warehouse_id" options="{'no_open': True, 'no_edit': True, 'no_create': True}"/>
            </xpath>
            <xpath expr="//field[@name='order_line']//field[@name='name']" position="after">
                <field name="remark" optional="hide"/>
            </xpath>
            <xpath expr="//field[@name='order_line']//field[@name='price_unit']" position="after">
                <field name="hsn_c" optional="hide"/>
            </xpath>
            <xpath expr="//field[@name='order_line']//field[@name='product_id']" position="after">
                <field name="article_code" optional="hide"/>
            </xpath>

        </field>
    </record>

</odoo>
