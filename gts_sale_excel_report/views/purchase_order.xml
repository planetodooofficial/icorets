<odoo>
    <data>

        <record id="purchase_order_form_invoice_report" model="ir.ui.view">
            <field name="name">purchase.order.form.invoice.report</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">

                <xpath expr="//header" position="inside">
                    <button name="generate_excel" type="object" string="Print Purchase (XLSX)"/>
                </xpath>

            </field>
        </record>

        <record model="ir.actions.server" id="action_custom_export_purchase_order">
            <field name="name">Export Purchase Order</field>
            <field name="model_id" ref="purchase.model_purchase_order"/>
            <field name="binding_model_id" ref="purchase.model_purchase_order" />
            <field name="state">code</field>
            <field name="code">
                if records:
                    action = records.generate_excel()
            </field>
        </record>

    </data>
</odoo>
