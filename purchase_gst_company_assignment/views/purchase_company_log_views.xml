<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Log List View -->
    <record id="view_purchase_company_reassignment_log_tree" model="ir.ui.view">
        <field name="name">purchase.company.reassignment.log.list</field>
        <field name="model">purchase.company.reassignment.log</field>
        <field name="arch" type="xml">
            <list string="PO Company Reassignment Audit Logs" create="0" delete="0">
                <field name="name"/>
                <field name="execution_date"/>
                <field name="user_id"/>
                <field name="source_company_id"/>
                <field name="target_company_id"/>
                <field name="gstin_id"/>
                <field name="gst_code"/>
                <field name="action_type"/>
                <field name="records_updated"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'success'"
                       decoration-muted="status == 'nothing_to_update'"
                       decoration-danger="status == 'failed'"/>
                <field name="summary"/>
            </list>
        </field>
    </record>

    <!-- Log Form View -->
    <record id="view_purchase_company_reassignment_log_form" model="ir.ui.view">
        <field name="name">purchase.company.reassignment.log.form</field>
        <field name="model">purchase.company.reassignment.log</field>
        <field name="arch" type="xml">
            <form string="Audit Log Entry" create="0" delete="0" edit="0">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Audit Header">
                            <field name="tool_id"/>
                            <field name="execution_date"/>
                            <field name="user_id"/>
                            <field name="status" widget="badge"/>
                        </group>
                        <group string="Company Transfer Info">
                            <field name="source_company_id"/>
                            <field name="target_company_id"/>
                            <field name="gstin_id"/>
                            <field name="gst_code"/>
                            <field name="action_type"/>
                            <field name="records_updated"/>
                        </group>
                    </group>
                    <group string="Execution Summary">
                        <field name="summary" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Log Search View -->
    <record id="view_purchase_company_reassignment_log_search" model="ir.ui.view">
        <field name="name">purchase.company.reassignment.log.search</field>
        <field name="model">purchase.company.reassignment.log</field>
        <field name="arch" type="xml">
            <search string="Search Logs">
                <field name="name"/>
                <field name="user_id"/>
                <field name="source_company_id"/>
                <field name="target_company_id"/>
                <field name="gstin_id"/>
                <field name="gst_code"/>
                <separator/>
                <filter string="Successful" name="filter_success" domain="[('status', '=', 'success')]"/>
                <filter string="Failed" name="filter_failed" domain="[('status', '=', 'failed')]"/>
                <group>
                    <filter string="Action Type" name="group_by_action" domain="[]" context="{'group_by': 'action_type'}"/>
                    <filter string="Status" name="group_by_status" domain="[]" context="{'group_by': 'status'}"/>
                    <filter string="User" name="group_by_user" domain="[]" context="{'group_by': 'user_id'}"/>
                    <filter string="Target Company" name="group_by_target" domain="[]" context="{'group_by': 'target_company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action for Logs -->
    <record id="action_purchase_company_reassignment_log" model="ir.actions.act_window">
        <field name="name">PO Company Reassignment Logs</field>
        <field name="res_model">purchase.company.reassignment.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_purchase_company_reassignment_log_search"/>
    </record>

    <!-- Menu for Logs -->
    <menuitem id="menu_purchase_company_reassignment_log"
              name="PO Company Reassignment Logs"
              parent="purchase.menu_purchase_config"
              action="action_purchase_company_reassignment_log"
              sequence="91"/>
</odoo>
